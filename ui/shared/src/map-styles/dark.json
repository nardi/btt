{
  "version": 8,
  "name": "btt-dark",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet.json",
      "attribution": "© OpenStreetMap contributors, tiles from OpenFreeMap"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#101014" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#20262e" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": { "line-color": "#20262e", "line-width": 1.5 }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 2],
      "layout": { "line-cap": "round" },
      "paint": { "line-color": "#2a2c35", "line-width": 1, "line-opacity": 0.8 }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["motorway", "trunk", "primary", "secondary"]]
      ],
      "layout": { "line-cap": "round" },
      "paint": {
        "line-color": "#2a2c35",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 14, 1.6]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["tertiary", "minor", "service", "path"]]
      ],
      "layout": { "line-cap": "round" },
      "paint": { "line-color": "#2a2c35", "line-width": 0.8, "line-opacity": 0.6 }
    },
    {
      "id": "place-small",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 9,
      "filter": ["in", ["get", "class"], ["literal", ["suburb", "village", "hamlet"]]],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#9a9fab",
        "text-halo-color": "#101014",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-big",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["city", "town"]]],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Bold"],
        "text-size": 14
      },
      "paint": {
        "text-color": "#ecedf0",
        "text-halo-color": "#101014",
        "text-halo-width": 1.5
      }
    }
  ]
}
