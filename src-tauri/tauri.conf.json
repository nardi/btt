{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BigTrainTrip",
  "identifier": "nl.nardilam.btt",
  "build": {
    "beforeDevCommand": "npm run dev --workspace ui/app",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --workspace ui/app",
    "frontendDist": "../ui/app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BigTrainTrip",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://tiles.openfreemap.org; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src blob:; child-src blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
